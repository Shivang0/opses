# dependencies / build
node_modules/
dist/
build/
__pycache__/
*.pyc

# env & secrets (never commit tokens/keys)
.env
.env.*
*.local
*.key
*.pem
secrets/

# test artifacts
playwright-report/
test-results/

# OPSES captured employee data (sensitive — never commit)
server/data/
*.pid
agent.log

# AI assistant state & chats — never upload
.claude/
**/.claude/
*.chat
chats/
transcripts/
.aider*
.cursor/

# Cloudflare Tunnel (transport/tunnel) — never commit tunnel credentials
transport/tunnel/*.log
transport/tunnel/*.pid
.cloudflared/
**/.cloudflared/
cert.pem
